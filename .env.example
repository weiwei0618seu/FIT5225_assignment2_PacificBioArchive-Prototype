# Shared non-secret runtime configuration. Copy to .env locally; never commit .env.
AWS_REGION=ap-southeast-2
PBA_APP_VERSION=0.1.0
PBA_MEDIA_BUCKET=replace-after-deployment
PBA_MEDIA_TABLE=replace-after-deployment
PBA_DEDUP_TABLE=replace-after-deployment
PBA_TEMP_QUERIES_TABLE=replace-after-deployment
PBA_SUBSCRIPTIONS_TABLE=replace-after-deployment
PBA_NOTIFICATION_EVENTS_TABLE=replace-after-deployment
PBA_NOTIFICATION_TOPIC_ARN=replace-after-deployment
PBA_TEMP_QUERY_FUNCTION=replace-after-deployment

# ML container paths/configuration (paths are inside the Linux container).
PBA_DETECTOR_MODEL_PATH=/opt/models/md_v5a.0.0.pt
PBA_CLASSIFIER_MODEL_PATH=/opt/models/model.torchscript
PBA_LABELS_PATH=/opt/models/labels.txt
PBA_MODEL_VERSION=supplied-v1
PBA_DETECTION_THRESHOLD=0.05
PBA_CLASSIFICATION_THRESHOLD=0.0
PBA_FORCE_CPU=true
PBA_MAX_VIDEO_SAMPLES=30

# Public SPA configuration; these values are identifiers/URLs, never secrets.
VITE_AWS_REGION=ap-southeast-2
VITE_API_BASE_URL=https://replace.execute-api.ap-southeast-2.amazonaws.com
VITE_COGNITO_USER_POOL_ID=replace-after-deployment
VITE_COGNITO_CLIENT_ID=replace-after-deployment
VITE_COGNITO_DOMAIN=https://replace.auth.ap-southeast-2.amazoncognito.com
VITE_ENABLE_GOOGLE_FEDERATION=false
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OAUTH_LOGOUT_URI=http://localhost:5173/login
